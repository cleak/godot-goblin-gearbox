root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,gdshader,gdshaderinc}]
indent_style = tab

[*.{py,ps1,json,jsonl,yaml,yml,toml,md}]
indent_style = space
indent_size = 2

[*.{py,ps1}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Godot writes these; an editor must not reflow them.
[*.{tscn,tres,godot,import,uid,cfg}]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
