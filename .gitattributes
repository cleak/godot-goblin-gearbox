# Text is stored with LF. gdformat and some editors write CRLF on Windows; git turns it
# back into LF on commit.
* text=auto eol=lf

# cmd.exe misreads a batch file with LF line endings.
*.bat text eol=crlf
*.cmd text eol=crlf

*.svg text

