{
  "description": "2D showcase (res://showcase/showcase_2d.tscn): light all four lamps and wake the lighthouse, screenshot each beat",
  "steps": [
    {"type": "call", "action": "reset"},
    {"type": "assert", "node": ".", "property": "player_stop", "equals": 7},
    {"type": "wait", "seconds": 0.5},
    {"type": "screenshot", "filename": "showcase_2d_0_start.png"},
    {"type": "tap", "action": "pause"},
    {"type": "tap", "action": "move_left"},
    {"type": "assert", "node": ".", "property": "motion_scale", "equals": 0.75},
    {"type": "assert", "node": ".", "property": "player_stop", "equals": 7},
    {"type": "assert", "node": "Hud", "property": "menu_open", "equals": true},
    {"type": "wait", "seconds": 0.4},
    {"type": "screenshot", "filename": "showcase_2d_menu.png"},
    {"type": "tap", "action": "move_right"},
    {"type": "tap", "action": "pause"},
    {"type": "assert", "node": ".", "property": "motion_scale", "equals": 1.0},
    {"type": "tap", "action": "move_right"},
    {"type": "wait", "seconds": 0.1},
    {"type": "screenshot", "filename": "showcase_2d_hop.png"},
    {"type": "wait", "seconds": 0.25},
    {"type": "tap", "action": "move_right"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_right"},
    {"type": "wait", "seconds": 0.3},
    {"type": "assert", "node": ".", "property": "player_stop", "equals": 10},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 1},
    {"type": "wait", "seconds": 0.15},
    {"type": "screenshot", "filename": "showcase_2d_1_ignite.png"},
    {"type": "wait", "seconds": 1.2},
    {"type": "tap", "action": "move_right"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_right"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_right"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 2},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "assert", "node": ".", "property": "player_stop", "equals": 4},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 3},
    {"type": "wait", "seconds": 2.6},
    {"type": "screenshot", "filename": "showcase_2d_2_three_lit.png"},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "move_left"},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 4},
    {"type": "assert", "node": ".", "property": "awake", "equals": true},
    {"type": "assert", "node": ".", "property": "steps", "equals": 18},
    {"type": "wait", "seconds": 1.6},
    {"type": "screenshot", "filename": "showcase_2d_3_waking.png"},
    {"type": "wait", "seconds": 4.0},
    {"type": "screenshot", "filename": "showcase_2d_4_awake.png"}
  ]
}
