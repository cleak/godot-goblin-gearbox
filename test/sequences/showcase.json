{
  "description": "Showcase (res://showcase/showcase.tscn): light all four lanterns and wake the gearbox, screenshot each beat",
  "steps": [
    {"type": "call", "action": "reset"},
    {"type": "assert", "node": ".", "property": "player_cell", "equals": {"x": 5, "y": 7}},
    {"type": "wait", "seconds": 0.5},
    {"type": "screenshot", "filename": "showcase_0_start.png"},
    {"type": "tap", "action": "pause"},
    {"type": "tap", "action": "move_left"},
    {"type": "assert", "node": ".", "property": "motion_scale", "equals": 0.75},
    {"type": "assert", "node": ".", "property": "player_cell", "equals": {"x": 5, "y": 7}},
    {"type": "assert", "node": "Hud", "property": "menu_open", "equals": true},
    {"type": "wait", "seconds": 0.4},
    {"type": "screenshot", "filename": "showcase_menu.png"},
    {"type": "tap", "action": "move_right"},
    {"type": "tap", "action": "pause"},
    {"type": "assert", "node": ".", "property": "motion_scale", "equals": 1.0},
    {"type": "tap", "action": "move_right"},
    {"type": "screenshot", "filename": "showcase_hop.png"},
    {"type": "assert", "node": ".", "property": "player_cell", "equals": {"x": 6, "y": 7}},
    {"type": "wait", "seconds": 0.3},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 1},
    {"type": "wait", "seconds": 0.12},
    {"type": "screenshot", "filename": "showcase_1_ignite.png"},
    {"type": "tap", "action": "move_left"},
    {"type": "tap", "action": "move_left"},
    {"type": "tap", "action": "move_left"},
    {"type": "tap", "action": "move_left"},
    {"type": "assert", "node": ".", "property": "player_cell", "equals": {"x": 2, "y": 7}},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 2},
    {"type": "tap", "action": "move_up"},
    {"type": "tap", "action": "move_up"},
    {"type": "tap", "action": "move_up"},
    {"type": "tap", "action": "move_up"},
    {"type": "tap", "action": "move_up"},
    {"type": "tap", "action": "move_up"},
    {"type": "assert", "node": ".", "property": "player_cell", "equals": {"x": 2, "y": 1}},
    {"type": "tap", "action": "move_left"},
    {"type": "assert", "node": ".", "property": "player_cell", "equals": {"x": 2, "y": 1}},
    {"type": "assert", "node": ".", "property": "facing", "equals": {"x": -1, "y": 0}},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 3},
    {"type": "wait", "seconds": 0.9},
    {"type": "screenshot", "filename": "showcase_2_three_lit.png"},
    {"type": "tap", "action": "move_right"},
    {"type": "tap", "action": "move_right"},
    {"type": "tap", "action": "move_right"},
    {"type": "tap", "action": "move_right"},
    {"type": "assert", "node": ".", "property": "player_cell", "equals": {"x": 6, "y": 1}},
    {"type": "tap", "action": "move_right"},
    {"type": "assert", "node": ".", "property": "awake", "equals": false},
    {"type": "tap", "action": "interact"},
    {"type": "assert", "node": ".", "property": "lit_count", "equals": 4},
    {"type": "assert", "node": ".", "property": "awake", "equals": true},
    {"type": "assert", "node": ".", "property": "steps", "equals": 15},
    {"type": "wait", "seconds": 1.2},
    {"type": "screenshot", "filename": "showcase_3_waking.png"},
    {"type": "wait", "seconds": 4.0, "until": {"node": ".", "property": "wake_shown", "equals": 1.0}},
    {"type": "assert", "node": "Gearbox", "property": "awake", "equals": true},
    {"type": "screenshot", "filename": "showcase_4_awake.png"}
  ]
}
